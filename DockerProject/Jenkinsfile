pipeline {
    agent any

    tools {
        maven 'maven3'
    }

    stages {

        stage('Clone') {
            steps {
                git url: 'https://github.com/MaheshThaku/springboot-docker-demo.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t springboot-app .'
            }
        }
    }
}